# AgentGuard environment configuration.
#
# Usage:
#   Docker Compose  →  cp .env.example .env  &&  docker compose up
#   Native dev      →  cp .env.example .env  &&  ./scripts/run-dev.sh
#
# Variables marked "(optional)" have built-in defaults; you can delete or
# leave them blank and everything will still start correctly.
#
# ─────────────────────────────────────────────────────────────────────────────
# MySQL  (docker-compose managed; change credentials if needed)
# ─────────────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=agentguard-root
MYSQL_USER=agentguard
MYSQL_PASSWORD=agentguard
MYSQL_DATABASE=agentguard

# ─────────────────────────────────────────────────────────────────────────────
# AgentGuard runtime server
# ─────────────────────────────────────────────────────────────────────────────
AGENTGUARD_PORT=38080                  # (optional) default: 38080
AGENTGUARD_MODE=enforce                # (optional) enforce | monitor | dry_run
AGENTGUARD_RUNTIME_MODE=sync           # (optional) sync | async
AGENTGUARD_LOG_LEVEL=info              # (optional) debug | info | warning | error
AGENTGUARD_API_KEY=sk-agentguard-backend-X9m42Vq7Tz8nL3pA6cR0yH5uJ1sWfKdE

# ─────────────────────────────────────────────────────────────────────────────
# State cache & persistence
# docker-compose sets AGENTGUARD_MYSQL_URL to the mysql service.
# scripts/run-dev.sh derives AGENTGUARD_MYSQL_URL from MYSQL_* to 127.0.0.1 when unset.
# Uncomment below only to override the native/local MySQL target explicitly.
# ─────────────────────────────────────────────────────────────────────────────
# AGENTGUARD_STATE_CACHE=redis://localhost:6379/0
# AGENTGUARD_MYSQL_URL=mysql://agentguard:agentguard@localhost:3306/agentguard
AGENTGUARD_USER_SESSION_TTL_SECONDS=86400
AGENTGUARD_USER_TICKET_TTL_SECONDS=300
AGENTGUARD_USER_EMAIL_CODE_TTL_SECONDS=600
AGENTGUARD_USER_EMAIL_CODE_COOLDOWN_SECONDS=60
AGENTGUARD_USER_EMAIL_CODE_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────────────────────
# User registration email verification
# ─────────────────────────────────────────────────────────────────────────────
# AGENTGUARD_SMTP_HOST=smtp.example.com
# AGENTGUARD_SMTP_PORT=587
# AGENTGUARD_SMTP_USERNAME=agentguard@example.com
# AGENTGUARD_SMTP_PASSWORD=change-me
# AGENTGUARD_SMTP_FROM=agentguard@example.com
# AGENTGUARD_SMTP_USE_TLS=true

# ─────────────────────────────────────────────────────────────────────────────
# Frontend web UI  (served by the `frontend` docker-compose service)
# ─────────────────────────────────────────────────────────────────────────────
AGENTGUARD_FRONTEND_PORT=38008         # (optional) host port for the web UI
# FRONTEND_PORT=38008                   # optional native preview port
# AGENTGUARD_API_BASE=http://localhost:38080  # override for native dev

# Server plugin config (optional). Used by the remote/server plugin manager.
# Rule-based plugin settings, including LLM_CHECK reviewer config, live in
# ./config/plugins.json -> rule_based_plugin.env
AGENTGUARD_SERVER_PLUGIN_CONFIG=./config/plugins.json
